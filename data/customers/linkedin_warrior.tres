[gd_resource type="Resource" script_class="CustomerData" format=3]

[ext_resource type="Script" path="res://scripts/data/customer_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "linkedin_warrior"
display_name = "LinkedIn Warrior"
conversations = PackedStringArray("I'm beyond excited to announce I've formed a new thought! Thank you, coffee chat!\nshrimp: ...congrats? are we on a coffee chat?\nOf course! I reached my current position of unemployment by taking advantage of all opportunities to network. Now, why don't you make sure we have some coffee for this chat? Some sauce from home too... Really makes you nostalgic, but we must move forward!", "Unpopular Opinion: Flat whites aren't quite right without the temperature being flat too.!\nshrimp: huh. okay, i guess?.\nI'm so delighted to meet a like-minded individual! With some great coffee, I'm sure we can bond wonderfully on this fine day, and even start an AI B2B SaaS business together!","LinkedIn Larper 9999 wants to connect with you...\nshrimp: ...what?\nI'm delighted to announce that I've made a wonderful new connection! Our new bond reminds of me of my favorite sauce from home... I intend to approach this connection with a laid-back approach, like a delicious chilled treat!")
required = PackedStringArray("espresso", "milk", "soy_sauce", "ice_cream")
hated = PackedStringArray("bud_darks")
reviews = PackedStringArray("This isn't getting me any coffee chats.", "you gotta use ai b2b saas way more this is terrible", "you're barely worth the amount of likes i got", "reply to my dms please!", "Do you take internships? 🙌🙌🙌🙌🙌🙌🙌🙌🙌🙌🙌")
